{
  "name": "m5-tech",
  "private": true,
  "description": "M5-Tech marketing site — React frontend, Express API, PostgreSQL",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm run test -w server",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:setup": "npm run db:setup -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": "22.x"
  }
}
