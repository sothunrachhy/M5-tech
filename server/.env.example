# ── Local development (copy to server/.env) ──────────────────────────
PORT=4000
DATABASE_URL=postgres://m5tech:m5tech_dev@localhost:5442/m5tech

# ── Production / Vercel (set in Vercel → Project → Settings → Environment Variables) ──
# DATABASE_URL   Hosted Postgres (Neon / Supabase). Use the POOLED connection string,
#                with ?sslmode=require. Neon via the Vercel Marketplace sets this for you.
# IP_HASH_SALT   Any long random string. Used to hash visitor IPs for the form rate limit.
# INQUIRY_RATE_LIMIT  Optional. Form submissions per visitor per 15 min (default 5).
# PG_POOL_MAX    Optional. Connections per serverless instance (default 3 on Vercel).
